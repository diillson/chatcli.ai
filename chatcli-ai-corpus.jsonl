      "correlationId": "checkout-service-oom-kill-1773871200",
      "detail": "approvers=sre-oncall; auto=false; decision=approved; issue=checkout-service-oom-kill-1773871200",
      "timestamp": "2026-03-19T15:35:00Z",
      "creationTimestamp": "2026-03-19T15:35:00Z"
    },
    {
      "name": "audit-1773935400987654321-p8x2wd",
