    "totalRemediations": 30,
    "successfulRemediations": 26,
    "failedRemediations": 3,
    "remediatedIssues": 28,
    "resolvedByRemediation": 25,
    "totalPostMortems": 34,
    "postMortemsRequiringHumanAction": 1,
    "totalRunbooks": 12,
    "totalSLOs": 8,
    "slosAtRisk": 0,
    "pendingApprovals": 2,
    "avgRiskScore": 47.5,
    "severityBreakdown": {
      "critical": 3,
      "high": 12,
      "medium": 18,
      "low": 9
    }
  }
}
