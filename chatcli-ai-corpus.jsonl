      "burnRate72h": 1,
      "activeAlerts": 0,
      "state": "Healthy",
      "creationTimestamp": "2026-01-15T10:00:00Z"
    },
    {
      "name": "api-gateway-latency",
      "namespace": "production",
      "service": "api-gateway",
      "sli": "latency",
      "target": 99,
      "window": "7d",
      "currentValue": 99.6,
      "errorBudgetTotal": 0.01,
      "errorBudgetUsed": 0.004,
      "errorBudgetRemaining": 60,
      "burnRate1h": 0.5,
